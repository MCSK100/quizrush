# --- AI questions (pick ONE) ---
#
# OPTION 1 — easiest, no rebuild of code needed:
#   Paste your key in the app at Settings → Gemini API key.
#   (Stored only in your browser.)
#
# OPTION 2 — .env file (needs a dev-server restart / rebuild):
# 1. Get a free key at https://aistudio.google.com/apikey
# 2. Copy this file to `.env` and paste the key below
# 3. Restart `npm run dev` (Vite reads .env only at startup)
VITE_GEMINI_API_KEY=

# --- Production (server proxy, recommended) ---
# Keep the key secret on your Render server instead of the client,
# then point the client at your endpoint:
# VITE_AI_ENDPOINT=https://your-server.onrender.com/api/questions
