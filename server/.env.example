# Primary: Gemini (free) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash

# Fallback when Gemini hits 429/quota: OpenRouter — https://openrouter.ai/keys
# Server tries all Gemini models first, then all OpenRouter models.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free,mistralai/mistral-7b-instruct:free,google/gemma-2-9b-it:free
# Optional, for OpenRouter rankings:
# OPENROUTER_SITE=https://your-frontend-url

PORT=8787
