# Primary: Gemini (free) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest

# Fallback 1 when Gemini hits 429/quota: OpenRouter — https://openrouter.ai/keys
# Server tries all Gemini models first, then all OpenRouter models.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free,google/gemma-4-31b-it:free,openai/gpt-oss-20b:free

# Fallback 2 (free, no card, generous limits): Groq — https://console.groq.com/keys
# Speed: fastest model of each configured provider is raced in parallel;
# large sets are split into parallel ~10-question chunks. Sequential chain
# (Gemini → OpenRouter → Groq → offline bank) is only the fallback.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b
# Optional, for OpenRouter rankings:
# OPENROUTER_SITE=https://your-frontend-url
# Optional, max ms the server spends on AI before using the offline bank:
# AI_BUDGET_MS=30000

PORT=8787
