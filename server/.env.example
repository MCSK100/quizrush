# Primary: Gemini (free) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash,gemini-2.5-flash-lite

# Fallback 1 when Gemini hits 429/quota: OpenRouter — https://openrouter.ai/keys
# Server tries all Gemini models first, then all OpenRouter models.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-20b:free,openai/gpt-oss-120b:free,google/gemma-3-27b-it:free

# Fallback 2 (free, no card, generous limits): Groq — https://console.groq.com/keys
# Chain order: Gemini → OpenRouter → Groq → offline bank (always works).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b,openai/gpt-oss-120b,qwen/qwen3-32b
# Optional, for OpenRouter rankings:
# OPENROUTER_SITE=https://your-frontend-url

PORT=8787
